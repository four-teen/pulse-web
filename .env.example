# Development only. Production uses the server-side PULSE_API_ORIGIN below.
PULSE_DEV_API_ORIGIN=http://127.0.0.1:8000
# Set in Vercel, without /auth or a trailing slash. Never prefix this with VITE_.
# PULSE_API_ORIGIN=https://api.example.edu.ph
# Server-side Vercel secret; match pulse-api/.env for production.
# PULSE_PROXY_SECRET=
